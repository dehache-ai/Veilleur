# Copier ce fichier en `.env` (dans ce dossier) et
# renseigner les valeurs. Ne jamais commiter le vrai `.env`.

# Narration vocale (Gradium) — optionnelle : sans clé, mode texte de secours.
GRADIUM_API_KEY=

# Recherche d'hôtels réelle (Jinko) — optionnelle : sans clé, l'outil factice
# est utilisé (défaut). Utilisée seulement avec --real-jinko.
JINKO_API_KEY=

# Gardiens LLM via OpenAI — seulement si `python switch_backend.py openai`.
# Le backend par défaut (Ollama, local) n'en a pas besoin.
OPENAI_API_KEY=
